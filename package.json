{
  "name": "idm-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:provision-dev-admin": "tsx src/db/provision-development-admin.ts",
    "db:provision-google-admin": "tsx src/db/provision-google-admin.ts",
    "db:verify-integrity": "node scripts/verify-financial-integrity.mjs",
    "db:verify-app-security": "tsx scripts/verify-app-security.ts",
    "db:studio": "drizzle-kit studio",
    "db:postgres:migrate": "tsx scripts/postgres-migrate.ts",
    "db:postgres:import": "tsx scripts/import-sqlite-to-postgres.ts",
    "db:postgres:verify-import": "tsx scripts/verify-postgres-migration.ts",
    "db:postgres:verify-ledger": "tsx scripts/verify-postgres-ledger-rules.ts",
    "db:verify-cash": "tsx scripts/verify-cash-reconciliation.ts",
    "db:verify-inventory-pos": "tsx scripts/verify-inventory-pos.ts",
    "test:cash:postgres": "node scripts/test-cash-postgres.mjs",
    "test:inventory-pos:postgres": "node scripts/test-inventory-pos-postgres.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.8.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.19.0"
}
