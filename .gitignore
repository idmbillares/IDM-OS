# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.crt
*.cer
*.key
*.p12
*.pfx
*credential*.json
*credentials*.json
*secret*.json
*service-account*.json
*service_account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.pnpm-store/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# SQLite local data. Migrations are versioned in /drizzle instead.
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/branding/
/backups/*.db
/backups/*.db-shm
/backups/*.db-wal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
