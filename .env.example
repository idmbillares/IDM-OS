# SQLite local de desarrollo. No usar datos reales en esta base.
DATABASE_URL=./data/idm-os.db

# Supabase PostgreSQL. Mantén DATABASE_URL apuntando a SQLite hasta validar la
# migración. Nunca uses prefijos NEXT_PUBLIC_ para estas conexiones.
POSTGRES_MIGRATIONS_URL=
POSTGRES_RUNTIME_URL=
POSTGRES_SSL_CERT=

# El adaptador local solo funciona fuera de producción. Estos identificadores
# no son credenciales: el rol siempre se consulta en la base de datos.
IDM_AUTH_MODE=local-development
IDM_DEV_ACTOR_ID=3fb627c4-64ab-4db4-bc9d-0ea0b0ac08ae
IDM_DEV_ACTOR_EMAIL=felipe.martinez.local@idm.test
IDM_DEV_ACTOR_NAME=Felipe Martínez

# Genera un secreto único con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
IDM_DEV_SESSION_SECRET=

# Google OAuth (usar IDM_AUTH_MODE=google fuera del desarrollo local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Déjalo vacío en localhost. Para una URL HTTPS fija (por ejemplo, un túnel de
# desarrollo), configura aquí la URL pública exacta, sin barra final.
AUTH_URL=
IDM_ADMIN_EMAIL=
IDM_ADMIN_NAME=Felipe Martínez
