# Desarrollo local y recuperación heredada; nunca definir en Vercel.
DATABASE_URL=./data/idm-os.db

# Solo mantenimiento local de migraciones; no definir en Vercel.
POSTGRES_MIGRATIONS_URL=
# Runtime obligatorio en Vercel. Nunca uses prefijos NEXT_PUBLIC_.
POSTGRES_RUNTIME_URL=
# Certificado raíz oficial de Supabase en formato PEM. Obligatorio en Vercel.
POSTGRES_SSL_CERT=
# Solo desarrollo local: ruta a un certificado PEM/CRT. No usar en Vercel.
POSTGRES_SSL_CERT_FILE=

# Solo desarrollo local; no definir en Vercel. Estos identificadores
# no son credenciales: el rol siempre se consulta en la base de datos.
IDM_AUTH_MODE=local-development
IDM_DEV_ACTOR_ID=3fb627c4-64ab-4db4-bc9d-0ea0b0ac08ae
IDM_DEV_ACTOR_EMAIL=felipe.martinez.local@idm.test
IDM_DEV_ACTOR_NAME=Felipe Martínez

# Genera un secreto único con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
IDM_DEV_SESSION_SECRET=

# Producción Vercel / Google OAuth. Todas son server-only; nunca uses el
# prefijo NEXT_PUBLIC_. En producción IDM_AUTH_MODE debe cambiar a google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# URL HTTPS pública y canónica de Vercel, sin barra final. Debe coincidir con
# la URI de redirección autorizada de Google OAuth.
AUTH_URL=
# Solo para el comando local db:provision-google-admin; no son necesarias en
# el runtime de Vercel.
IDM_ADMIN_EMAIL=
IDM_ADMIN_NAME=
